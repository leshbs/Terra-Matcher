# Browser-safe Supabase configuration. Never place a service-role key here.
# Deployed environments must use API mode; fixture mode is development/test only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
COMPARISON_DATA_SOURCE=api
COMPARISON_API_ORIGIN=http://localhost:3000
EXPLORER_DATA_SOURCE=api
# Server-only; never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

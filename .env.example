# Browser-safe Supabase configuration. Never place a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Use the Supabase-backed Explorer API. Set to fixture only for explicit local UI work.
NEXT_PUBLIC_EXPLORER_DATA_SOURCE=api
# Server-only; never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
